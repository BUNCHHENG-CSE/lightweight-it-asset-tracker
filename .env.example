# ============================================================================
# Database Configuration — Lightweight IT Asset Lifecycle Tracker
# ============================================================================
#
# DUAL DATABASE STRATEGY:
# 1. LOCAL DEVELOPMENT (SQLite - Zero Config):
#    Leave DATABASE_URL commented out or empty.
#    The application automatically runs on local SQLite (lifecycle-tracker.db).
#    All 5 lifecycle stages, money leaks engine, NIST wipe logs, thermal barcode
#    printing, and audit scanner work immediately with zero setup.
#
# 2. PRODUCTION (PostgreSQL via Neon Serverless):
#    Set DATABASE_URL to your Neon connection string.
#    The application automatically routes queries through Prisma ORM using
#    Neon Serverless (@prisma/adapter-neon) or pg.Pool (@prisma/adapter-pg).
#    Tables and composite indexes are automatically initialized and seeded.
# ============================================================================

# --- Option 1: Managed Cloud PostgreSQL on Neon (Production Recommended) ---
# Copy from your Neon Console (neon.tech -> Project -> Connection Details):
# Pooled connection string (with -pooler) for Next.js runtime:
# DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-cool-sample-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct / Unpooled connection string for running Prisma CLI migrations:
# DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-cool-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Option 2: Local Docker Compose PostgreSQL 16 (Optional) ---
# DATABASE_URL="postgresql://lifecycle_admin:lifecycle_prod_password@localhost:5432/asset_lifecycle_tracker"

# --- Option 3: Local SQLite (Active by default when DATABASE_URL is unset) ---
# No variables needed! Runs automatically on ./lifecycle-tracker.db
# To use Prisma Studio with SQLite: bun run db:sqlite:studio

# --- Connection Pool Tuning (Optional for PostgreSQL) ---
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONN_TIMEOUT_MS=5000
PG_SSL=false
